# Copy to .env for local development (never commit .env)
PORT=8080
BASE_URL=http://localhost:8080

# Auth0 application (Regular Web App). Callback URL: <BASE_URL>/callback, logout URL: <BASE_URL>
AUTH0_ISSUER_BASE_URL=https://YOUR-TENANT.eu.auth0.com
AUTH0_CLIENT_ID=
# Optional: enables the authorization-code flow (recommended)
AUTH0_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# SQLite file. Put it on a persistent volume in production.
DATABASE_PATH=data/goalgetters.db

# Optional SMTP, e.g. smtp://user:pass@sandbox.smtp.mailtrap.io:2525. If unset, shared goals are only logged.
SMTP_URL=
MAIL_FROM=Goal Getters <no-reply@example.com>

# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
